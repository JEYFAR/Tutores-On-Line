# =============================================================================
# TutoresOnLine - Plantilla de Variables de Entorno (.env.example)
# COPIA ESTE ARCHIVO COMO .env Y AJUSTA TUS CREDENCIALES LOCALES
# =============================================================================

# Entorno de la aplicación
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/tutoresonline/public

# Secreto pepper para reforzar el hashing de contraseñas (cadena aleatoria)
APP_PEPPER=cambiar_por_una_cadena_secreta_aleatoria_para_produccion

# Configuración de Base de Datos (USBWebserver por defecto)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tutoresonline
DB_USER=root
DB_PASS=usbw

# Configuración de Correo Electrónico
# MAIL_DRIVER: 'log' para escribir enlaces a logs/mail.log (pruebas locales), o 'smtp'
MAIL_DRIVER=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_password_de_aplicacion
SMTP_FROM=no-reply@tutoresonline.com
SMTP_FROM_NAME="TutoresOnLine"

# Google OAuth2 (Opcional para flujo extra de Google Login)
GOOGLE_CLIENT_ID=tu_google_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
GOOGLE_REDIRECT_URI=http://localhost/tutoresonline/public/oauth_callback.php
